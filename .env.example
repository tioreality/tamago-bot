# =========================================================
# TAMAGO — Variables de entorno (EJEMPLO)
# Copia este archivo como ".env" y rellena tus propios valores.
# NUNCA subas el archivo ".env" real a git ni lo compartas.
# =========================================================

# --- Bot de Discord ---

# Token del bot de Discord (Developer Portal > Bot > Reset Token)
# Obligatorio. Sin esto el bot no puede iniciar sesión.
DISCORD_TOKEN=tu_token_aqui

# Clave de la API de Anthropic (Claude), usada en la Etapa 2 para las
# respuestas con personalidad e inteligencia artificial.
# Consíguela en: https://console.anthropic.com/settings/keys
# Obligatoria a partir de la Etapa 2 (el bot no arranca sin esto).
ANTHROPIC_API_KEY=tu_api_key_aqui

# Qué modelo de Claude usar para las respuestas. Opcional -- si no lo
# pones, usa un valor por defecto razonable. Lista de modelos vigentes:
# https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# IDs de los canales de Discord donde TAMAGO puede responder con IA al
# mencionarlo, separados por comas (ej. 111222333,444555666).
# Obligatorio para que responda en algún lado -- VACÍO POR DEFECTO A
# PROPÓSITO (nadie autorizado todavía). Para conseguir un ID: activa
# "Modo desarrollador" en Discord (Ajustes > Avanzado), clic derecho
# sobre el canal > Copiar ID de canal.
AI_ALLOWED_CHANNEL_IDS=

# Segundos mínimos entre dos respuestas de IA a la MISMA persona en el
# MISMO canal (anti-spam). Opcional. Por defecto: 8
AI_COOLDOWN_SECONDS=8

# Máximo de respuestas de IA que TAMAGO puede dar en total (todos los
# canales) por minuto -- protege el costo de la API. Opcional. Por
# defecto: 10
AI_MAX_RESPONSES_PER_MINUTE=10

# Prefijo para comandos de texto clásicos (además de las menciones).
# Opcional. Por defecto: !
COMMAND_PREFIX=!

# ID del servidor (guild) principal donde operará el bot.
# Obligatorio para el panel (Etapa 2). Opcional para el bot en la Etapa 1
# (solo se usa para logs informativos).
GUILD_ID=

# Nivel de detalle de los registros: DEBUG, INFO, WARNING, ERROR
# Opcional. Por defecto: INFO
LOG_LEVEL=INFO


# --- Base de datos compartida (bot + panel) ---
# Datos de tu base de datos MySQL (ej. Hostinger). El bot y el panel se
# conectan a la misma base para compartir personalidad, config de
# canales y logs de actividad.
# Obligatorias a partir de que el panel entre en uso.

MYSQL_HOST=tu_host_mysql_aqui
MYSQL_PORT=3306
MYSQL_USER=tu_usuario_mysql_aqui
MYSQL_PASSWORD=tu_password_mysql_aqui
MYSQL_DATABASE=tu_base_de_datos_aqui


# --- Panel web (Etapa 2) ---
# Solo las necesita el servicio del panel, no el bot. Aun así viven en el
# mismo archivo de ejemplo para simplicidad.

# ID de cliente OAuth2 de tu aplicación de Discord. Es el mismo "Application ID"
# que ya tienes (Developer Portal > tu app > OAuth2 > Client ID). No es secreto.
DISCORD_CLIENT_ID=tu_client_id_aqui

# Client Secret de OAuth2 (Developer Portal > tu app > OAuth2 > Client Secret).
# Esto SÍ es un secreto: es distinto del token del bot, pero se trata igual
# de cuidado. Si se filtra, se regenera desde la misma pantalla.
DISCORD_CLIENT_SECRET=tu_client_secret_aqui

# URL exacta a la que Discord debe devolver al usuario tras iniciar sesión.
# Debe coincidir con una "Redirect URI" registrada en el Developer Portal
# (OAuth2 > Redirects). En local suele ser http://localhost:8000/auth/callback
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback

# ID del rol de Discord que puede entrar al panel (clic derecho sobre el
# rol en Discord, con el "Modo desarrollador" activado > Copiar ID de rol).
ADMIN_ROLE_ID=tu_id_de_rol_admin_aqui

# Clave usada para firmar las cookies de sesión del panel (no es una
# contraseña de ninguna cuenta: es un valor aleatorio, largo, que solo el
# panel necesita). Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
PANEL_SECRET_KEY=tu_clave_aleatoria_larga_aqui
