# =========================================================
# TAMAGO — Variables de entorno (EJEMPLO)
# Copia este archivo como ".env" y rellena tus propios valores.
# NUNCA subas el archivo ".env" real a git ni lo compartas.
# =========================================================

# Token del bot de Discord (Developer Portal > Bot > Reset Token)
# Obligatorio. Sin esto el bot no puede iniciar sesión.
DISCORD_TOKEN=tu_token_aqui

# Clave de la API de Anthropic (Claude), usada en la Etapa 2 para las
# respuestas con personalidad e inteligencia artificial.
# Consíguela en: https://console.anthropic.com/settings/keys
# Obligatoria a partir de la Etapa 2. En la Etapa 1 no se usa.
ANTHROPIC_API_KEY=tu_api_key_aqui

# Prefijo para comandos de texto clásicos (además de las menciones).
# Opcional. Por defecto: !
COMMAND_PREFIX=!

# ID del servidor (guild) principal donde operará el bot.
# Opcional en la Etapa 1 (solo se usa para logs informativos).
GUILD_ID=

# Nivel de detalle de los registros: DEBUG, INFO, WARNING, ERROR
# Opcional. Por defecto: INFO
LOG_LEVEL=INFO
